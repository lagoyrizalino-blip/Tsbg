local HITBOX_LIMB_NAMES = {
    ["HumanoidRootPart"]=true, ["Head"]=true, ["Torso"]=true,
    ["UpperTorso"]=true, ["LowerTorso"]=true,
    ["LeftUpperArm"]=true, ["RightUpperArm"]=true,
    ["LeftLowerArm"]=true, ["RightLowerArm"]=true,
    ["LeftHand"]=true, ["RightHand"]=true,
    ["LeftUpperLeg"]=true, ["RightUpperLeg"]=true,
    ["LeftLowerLeg"]=true, ["RightLowerLeg"]=true,
    ["LeftFoot"]=true, ["RightFoot"]=true,
    ["Left Arm"]=true, ["Right Arm"]=true,
    ["Left Leg"]=true, ["Right Leg"]=true,
}
local function makeHitboxPart(sourcePart, char)
    local hb = Instance.new("Part")
    hb.Name = "HitboxExpander"
    hb.Size = Vector3.new(HITBOX_SIZE, HITBOX_SIZE, HITBOX_SIZE)
    hb.Transparency = 1
    hb.CanCollide = false
    hb.CanTouch = true
    hb.CanQuery = true
    hb.Massless = true
    hb.Anchored = false
    hb.CFrame = sourcePart.CFrame
    hb.Parent = char
    local weld = Instance.new("WeldConstraint")
    weld.Part0 = sourcePart
    weld.Part1 = hb
    weld.Parent = hb
    return hb
end
local function applyHitboxToCharacter(char)
    if not HITBOX_ENABLED or not char then return end
    if hitboxParts[char] then return end
    local list = {}
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") and HITBOX_LIMB_NAMES[part.Name] then
            local ok, hb = pcall(makeHitboxPart, part, char)
            if ok and hb then table.insert(list, hb) end
        end
    end
    hitboxParts[char] = list
end
local function clearHitboxFromCharacter(char)
    if not char then return end
    local list = hitboxParts[char]
    if list then
        for _, p in ipairs(list) do if p and p.Parent then p:Destroy() end end
        hitboxParts[char] = nil
    end
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BasePart") and d.Name == "HitboxExpander" then
            pcall(function() d:Destroy() end)
        end
    end
end
local function clearAllHitboxes()
    for char in pairs(hitboxParts) do clearHitboxFromCharacter(char) end
    hitboxParts = {}
end
local function refreshAllHitboxes()
    if not HITBOX_ENABLED then return end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then applyHitboxToCharacter(plr.Character) end
    end
end

