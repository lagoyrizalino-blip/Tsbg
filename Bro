local function hasFileIO()
    return (type(writefile) == "function") and (type(readfile) == "function") and (type(isfile) == "function")
end
local function loadActiveChangelog()
    local entries, storedVersion = {}, nil
    local io = hasFileIO()
    if io then
        pcall(function()
            if isfile(CHANGELOG_FILE) then
                local content = readfile(CHANGELOG_FILE) or ""
                for line in content:gmatch("[^\r\n]+") do
                    if line:sub(1, 8) == "VERSION|" then
                        local v = line:match("^VERSION|([^|]+)|")
                        if v then storedVersion = v end
                    else
                        local ts, text = line:match("^(%d+)|(.+)$")
                        if ts and text then table.insert(entries, { ts = tonumber(ts), text = text }) end
                    end
                end
            end
        end)
    end
    local now = os.time()
    local active = {}
    if storedVersion and storedVersion ~= CURRENT_VERSION then entries = {} end
    for _, e in ipairs(entries) do
        if (now - e.ts) < CHANGELOG_TTL then table.insert(active, e) end
    end
    if storedVersion ~= CURRENT_VERSION then
        local existing = {}
        for _, e in ipairs(active) do existing[e.text] = true end
        for i = #CURRENT_UPDATE, 1, -1 do
            local text = CURRENT_UPDATE[i]
            if not existing[text] then
                table.insert(active, 1, { ts = now, text = text })
                existing[text] = true
            end
        end
    end
    if io then
        pcall(function()
            local out = { "VERSION|" .. CURRENT_VERSION .. "|" .. now }
            for _, e in ipairs(active) do table.insert(out, e.ts .. "|" .. e.text) end
            writefile(CHANGELOG_FILE, table.concat(out, "\n"))
        end)
    end
    table.sort(active, function(a, b) return a.ts > b.ts end)
    local display = {}
    for _, e in ipairs(active) do table.insert(display, e.text) end
    return display
end
local ACTIVE_CHANGELOG = loadActiveChangelog()

