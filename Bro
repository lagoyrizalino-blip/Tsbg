-- ========== HIDE HIT ==========
local HIDE_DURATION = 1.5
local RETURN_DURATION = 0.6
local RETURN_MAX_TIME = 3
local RETURN_TOLERANCE = 6

local posHistory = {}
RunService.Heartbeat:Connect(function()
    if not gui.Parent then return end
    if isHidingHit or safeActive or tpVoidRunning then return end
    local c = LocalPlayer.Character
    local r = c and c:FindFirstChild("HumanoidRootPart")
    if not r then return end
    local now = os.clock()
    posHistory[#posHistory + 1] = { t = now, cf = r.CFrame }
    while #posHistory > 0 and (now - posHistory[1].t) > 0.5 do
        table.remove(posHistory, 1)
    end
end)
local function getPreHitCFrame(fallback)
    local now = os.clock()
    for _, e in ipairs(posHistory) do
        if (now - e.t) <= 0.3 then return e.cf end
    end
    return fallback
end

local function runHideHit(char, hum, savedCFrame, hideCFrame, hidePlatform)
    local function finish()
        if hidePlatform then pcall(function() hidePlatform:Destroy() end) end
        isHidingHit = false
    end
    task.delay(HIDE_DURATION + RETURN_DURATION + 5, function()
        if isHidingHit then finish() end
    end)
    local ok, err = pcall(function()
        local t0 = os.clock()
        while (os.clock() - t0) < HIDE_DURATION and hum.Health > 0 and char.Parent and HIDE_HIT_ENABLED do
            pivotCharacterTo(hideCFrame)
            RunService.Heartbeat:Wait()
        end
        if hum.Health <= 0 or not char.Parent then return end
        status.Text = "Hide Hit: returning..."
        status.TextColor3 = THEME.SUCCESS
        pcall(function() LocalPlayer:RequestStreamAroundAsync(savedCFrame.Position, 2) end)
        local t1 = os.clock()
        local arrivedSince = nil
        while hum.Health > 0 and char.Parent do
            pivotCharacterTo(savedCFrame)
            RunService.Heartbeat:Wait()
            local r = char:FindFirstChild("HumanoidRootPart")
            local dist = r and (r.Position - savedCFrame.Position).Magnitude or math.huge
            local elapsed = os.clock() - t1
            if dist <= RETURN_TOLERANCE then
                arrivedSince = arrivedSince or os.clock()
                if (os.clock() - arrivedSince) >= RETURN_DURATION then break end
            else
                arrivedSince = nil
            end
            if elapsed >= RETURN_MAX_TIME then
                status.Text = string.format("Hide Hit: return failed (%.0f studs off)", dist == math.huge and -1 or dist)
                status.TextColor3 = THEME.DANGER
                break
            end
        end
        if hum.Health > 0 and char.Parent and not farming then
            unfreezeCharacter()
            local r = char:FindFirstChild("HumanoidRootPart")
            if r then
                r.AssemblyLinearVelocity = Vector3.zero
                r.AssemblyAngularVelocity = Vector3.zero
            end
        end
        if not string.find(status.Text, "failed", 1, true) then
            status.Text = "Hide Hit: returned"
        end
    end)
    if not ok then
        status.Text = "Hide Hit error: " .. tostring(err)
        status.TextColor3 = THEME.DANGER
    end
    finish()
end

