local function getRoot(plr) local c = plr and plr.Character; return c and c:FindFirstChild("HumanoidRootPart") end
findNextAlive = function(skip)
    local mine = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local best, bestHp, bestDist
    local voidY = workspace.FallenPartsDestroyHeight
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr ~= skip and isAlive(plr) and not isPlayerVoided(plr) then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            local root = plr.Character:FindFirstChild("HumanoidRootPart")
            if (root.Position.Y - voidY) > VOID_DANGER_DISTANCE then
                local hp = hum.Health
                local dist = mine and (mine.Position - root.Position).Magnitude or 0
                if not best or hp < bestHp or (hp == bestHp and dist < bestDist) then
                    best, bestHp, bestDist = plr, hp, dist
                end
            end
        end
    end
    return best
end
findNearestAlive = function(skip)
    local mine = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local best, bestDist
    local voidY = workspace.FallenPartsDestroyHeight
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr ~= skip and isAlive(plr) and not isPlayerVoided(plr) then
            local root = plr.Character:FindFirstChild("HumanoidRootPart")
            if (root.Position.Y - voidY) > VOID_DANGER_DISTANCE then
                local dist = mine and (mine.Position - root.Position).Magnitude or 0
                if not best or dist < bestDist then best, bestDist = plr, dist end
            end
        end
    end
    return best
end
local function findRandomAliveSkipCurrent()
    local pool = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr ~= selectedPlayer and isAlive(plr) and not isPlayerVoided(plr) then
            table.insert(pool, plr)
        end
    end
    if #pool == 0 then return nil end
    return pool[math.random(1, #pool)]
end
isTargetVoiding = function(_, targetRoot, targetHum)
    if not targetRoot or not targetRoot.Parent then return false end
    if not targetHum or targetHum.Health <= 0 then return false end
    local y = targetRoot.Position.Y; local vy = targetRoot.AssemblyLinearVelocity.Y
    local voidY = workspace.FallenPartsDestroyHeight
    if y <= voidY + 30 then return true end
    if vy < -200 and y <= voidY + 100 then return true end
    return false
end

local function restoreCamera()
    local cam = workspace.CurrentCamera
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if cam and hum then cam.CameraSubject = hum end
    pcall(function() LocalPlayer.DevCameraOcclusionMode = Enum.DevCameraOcclusionMode.Zoom end)
end
local function freezeCharacter()
    local char = LocalPlayer.Character; if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if hum then pcall(function() hum:ChangeState(Enum.HumanoidStateType.Physics); hum.PlatformStand = true end) end
    if root then root.AssemblyLinearVelocity = Vector3.zero; root.AssemblyAngularVelocity = Vector3.zero end
end
local function unfreezeCharacter()
    local char = LocalPlayer.Character; if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then pcall(function() hum.PlatformStand = false; hum:ChangeState(Enum.HumanoidStateType.GettingUp) end) end
end
local function pivotCharacterTo(cf)
    local char = LocalPlayer.Character; if not char then return end
    pcall(function() char:PivotTo(cf) end)
    local root = char:FindFirstChild("HumanoidRootPart")
    if root then root.CFrame = cf; root.AssemblyLinearVelocity = Vector3.zero; root.AssemblyAngularVelocity = Vector3.zero end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then pcall(function() hum:ChangeState(Enum.HumanoidStateType.Physics); hum.PlatformStand = true end) end
end
local function pivotFarm(cf)
    local char = LocalPlayer.Character; if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then pivotCharacterTo(cf); return end
    local delta = cf.Position - root.Position; local dist = delta.Magnitude
    if dist > FAR_TELEPORT_THRESHOLD then
        local dir = delta.Unit; local step = math.min(dist, MAX_PIVOT_STEP)
        local clampedPos = root.Position + dir * step
        pivotCharacterTo(cf - cf.Position + clampedPos)
    else pivotCharacterTo(cf) end
end
local function applyFarmNoclip(char)
    if not NOCLIP_ENABLED or not char then return end
    local now = os.clock()
    if #noclipParts == 0 or (now - lastPartScan) >= 0.3 then
        lastPartScan = now; noclipParts = {}
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then table.insert(noclipParts, p) end
        end
    end
    for _, p in ipairs(noclipParts) do
        if p.Parent then
            if orbitCollide[p] == nil then orbitCollide[p] = p.CanCollide end
            if p.CanCollide then p.CanCollide = false end
        end
    end
end
local function restoreCollisions()
    for part, was in pairs(orbitCollide) do
        if part and part.Parent then pcall(function() part.CanCollide = was end) end
    end
    orbitCollide = {}; noclipParts = {}
end
local function getBodyExtents(char)
    local minY, maxY = math.huge, -math.huge
    for _, p in ipairs(char:GetChildren()) do
        if p:IsA("BasePart") then
            local v = p.CFrame:VectorToObjectSpace(Vector3.yAxis)
            local half = (math.abs(v.X)*p.Size.X + math.abs(v.Y)*p.Size.Y + math.abs(v.Z)*p.Size.Z)/2
            local y = p.Position.Y
            if y - half < minY then minY = y - half end
            if y + half > maxY then maxY = y + half end
        end
    end
    if minY == math.huge then return nil end
    return minY, maxY
end
local function findFloorY(x, z, fromY, fallbackY)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local ignore = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character then table.insert(ignore, plr.Character) end
    end
    params.FilterDescendantsInstances = ignore; params.IgnoreWater = true; params.RespectCanCollide = true
    local hit = workspace:Raycast(Vector3.new(x, fromY, z), Vector3.new(0, -1000, 0), params)
    if hit then return hit.Position.Y end
    return fallbackY
end
local function clearPushObjects(root)
    restoreCollisions()
    if root then
        for _, n in ipairs({"UnderPushBV","UpPushBV"}) do
            local bv = root:FindFirstChild(n); if bv then bv:Destroy() end
        end
    end
end

local function getPredictedPos()
    if not tRoot then return nil end
    local pos = tRoot.Position
    if PREDICTION_ENABLED then
        local vel = tRoot.AssemblyLinearVelocity
        local delta = vel * PREDICTION_TIME
        if delta.Magnitude > PREDICTION_MAX_LEAD then delta = delta.Unit * PREDICTION_MAX_LEAD end
        local predicted = pos + delta
        local voidY = workspace.FallenPartsDestroyHeight
        if predicted.Y < voidY + 30 then predicted = Vector3.new(predicted.X, pos.Y, predicted.Z) end
        pos = predicted
    end
    return pos
end
local function getBehindCFrame(targetPos, distance)
    local base = tRoot.CFrame
    local lookVec = base.LookVector
    local behindPos = targetPos - (lookVec * distance)
    return CFrame.lookAt(behindPos, behindPos + lookVec)
end
local function getAboveCFrame(targetPos, distance)
    local abovePos = targetPos + Vector3.new(0, distance, 0)
    return CFrame.lookAt(abovePos, targetPos)
end
local function getCrossCFrame(targetPos, pointName)
    local baseLook = tRoot.CFrame.LookVector
    baseLook = Vector3.new(baseLook.X, 0, baseLook.Z)
    if baseLook.Magnitude < 0.05 then baseLook = Vector3.new(0,0,-1) else baseLook = baseLook.Unit end
    local baseRight = Vector3.new(baseLook.Z, 0, -baseLook.X)
    local localOffset
    if pointName == "front" then localOffset = baseLook * CROSS_STUDS
    elseif pointName == "back" then localOffset = baseLook * -CROSS_STUDS
    elseif pointName == "left" then localOffset = baseRight * -CROSS_STUDS
    elseif pointName == "right" then localOffset = baseRight * CROSS_STUDS
    else localOffset = baseLook * CROSS_STUDS end
    local pos = targetPos + localOffset + Vector3.new(0, CROSS_HEIGHT, 0)
    local dir = targetPos - pos
    if dir.Magnitude < 0.01 then return CFrame.new(pos) end
    return CFrame.lookAt(pos, targetPos)
end-- ========== STATE ==========
