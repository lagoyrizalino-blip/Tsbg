local function isPlayerVoided(plr)
    local t = voidedPlayers[plr]; if not t then return false end
    if (os.clock() - t) >= 3 then voidedPlayers[plr] = nil; return false end
    return true
end
local function isAlive(plr)
    local char = plr and plr.Character; if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    return hum ~= nil and root ~= nil and hum.Health > 0
        and hum:GetState() ~= Enum.HumanoidStateType.Dead
end
local function manualActive()
    return stickyManualPlayer ~= nil and isAlive(stickyManualPlayer) and not isPlayerVoided(stickyManualPlayer)
end

